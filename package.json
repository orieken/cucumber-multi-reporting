{
  "name": "playwright-cucumber-starter",
  "version": "0.0.2",
  "description": "template project for playwright with cucumber",
  "main": "index.js",
  "scripts": {
    "test": "jest",
    "lint": "eslint . --fix",
    "prepare": "husky install",
    "cucumber": "node_modules/.bin/cucumber-js ",
    "cu": "npm run cucumber",
    "cu:focus": "npm run cu -- -- -p focus",
    "prettier": "prettier 'features/**/*.ts'",
    "prettier:fix": "prettier --write 'features/**/*.ts'"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orieken/playwright-cucumber-starter.git"
  },
  "keywords": [
    "playwright",
    "cucumber",
    "typescript"
  ],
  "author": "Oscar Rieken <oriekenjr@gmail.com>",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/orieken/playwright-cucumber-starter/issues"
  },
  "homepage": "https://github.com/orieken/playwright-cucumber-starter#readme",
  "devDependencies": {
    "@cucumber/cucumber": "10.3.1",
    "@cucumber/pretty-formatter": "^1.0.0",
    "@playwright/test": "^1.41.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.17.6",
    "@types/pngjs": "6.0.5",
    "@typescript-eslint/eslint-plugin": "^7.0.2",
    "@typescript-eslint/parser": "^7.0.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.2",
    "playwright": "^1.41.2",
    "prettier": "^3.2.5",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": [
      "eslint --fix",
      "prettier --write ."
    ],
    "*.js": "eslint --cache --fix"
  },
  "prettier": {
    "semi": true,
    "trailingComma": "all",
    "singleQuote": true,
    "printWidth": 120,
    "tabWidth": 2,
    "allowTemplateLiterals": true,
    "bracketSpacing": true
  },
  "dependencies": {
    "@faker-js/faker": "^8.4.1",
    "@kubernetes/client-node": "^0.21.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "^0.54.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "^0.53.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.53.0",
    "@opentelemetry/instrumentation": "^0.53.0",
    "@opentelemetry/instrumentation-cucumber": "^0.9.0",
    "@opentelemetry/metrics": "^0.24.0",
    "@opentelemetry/resources": "^1.26.0",
    "@opentelemetry/sdk-metrics-base": "^0.31.0",
    "@opentelemetry/sdk-node": "^0.54.0",
    "@opentelemetry/sdk-trace-node": "^1.26.0",
    "@opentelemetry/sdk-trace-web": "^1.26.0",
    "@opentelemetry/semantic-conventions": "^1.27.0",
    "@rieken/cucumber-otel-reporter": "file:../cucumber-otel-formatter",
    "axios": "^1.7.2",
    "looks-same": "^9.0.1",
    "node-ssh": "^13.2.0",
    "pngjs": "7.0.0"
  }
}
